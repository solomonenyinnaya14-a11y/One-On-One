# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these per environment (Preview and Production) in Project Settings.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://vjebivcrhtaeqeofqlli.supabase.co
# Supabase dashboard > Project Settings > API Keys > publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: NEVER prefix with NEXT_PUBLIC_ and never import in client code.
# Supabase dashboard > Project Settings > API Keys > secret key
SUPABASE_SECRET_KEY=

